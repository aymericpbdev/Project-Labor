# Port du serveur Express
PORT=3000

# Environnement d'exécution (development | production | test)
NODE_ENV=development

# URL de connexion PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/labor

# Clé de signature des JWT (chaîne aléatoire d'au moins 32 caractères)
JWT_SECRET=

# Durée de validité du token (ex. 7d, 24h, 15m)
JWT_EXPIRES_IN=7d